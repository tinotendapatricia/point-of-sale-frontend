{
  "name": "admin-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pos-frontend",
  "sourceRoot": "apps/admin-portal/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/admin-portal",
        "index": "apps/admin-portal/src/index.html",
        "main": "apps/admin-portal/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/admin-portal/tsconfig.app.json",
        "assets": [
          "apps/admin-portal/src/favicon.ico",
          "apps/admin-portal/src/assets"
        ],
        "styles": [
          "apps/admin-portal/src/styles.scss",
          "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
          "node_modules/@clr/ui/clr-ui.min.css",
          "node_modules/izitoast/dist/css/iziToast.min.css"
        ],
        "scripts": ["node_modules/izitoast/dist/js/iziToast.min.js"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "admin-portal:build:production"
        },
        "development": {
          "buildTarget": "admin-portal:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "admin-portal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/admin-portal/jest.config.ts",
        "tsConfig": "apps/admin-portal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin-portal:build"
      }
    }
  }
}
