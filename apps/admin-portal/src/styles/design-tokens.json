{
  "$comment": "Design tokens for the POS Admin console. Source of truth: _ds/industry-c17dc4ae-e4db-4a84-9390-c21c85dfc7d7/styles.css plus the semantic status set added for this app. Values are exact — do not round the spacing scale to 4/8.",
  "color": {
    "ground": {
      "bg": "#f2f2f3",
      "surface": "#e9e9ea",
      "text": "#1d1f20",
      "divider": "color-mix(in srgb, #1d1f20 16%, transparent)"
    },
    "accent": {
      "base": "#5980a6",
      "100": "#eef6ff",
      "200": "#d6ebff",
      "300": "#b5d9fd",
      "400": "#94bce3",
      "500": "#749dc4",
      "600": "#597ea3",
      "700": "#416180",
      "800": "#2c455d",
      "900": "#1d2d3d"
    },
    "neutral": {
      "100": "#f5f5f8",
      "200": "#e7e7ea",
      "300": "#d4d4d7",
      "400": "#b7b7ba",
      "500": "#98989b",
      "600": "#7a7a7d",
      "700": "#5d5d60",
      "800": "#424244",
      "900": "#2b2b2d"
    },
    "status": {
      "$comment": "Added for this app. Same muted chroma as the steel accent so the board stays technical rather than jolly.",
      "ok": { "fg": "#2f7d5b", "bg": "#e2f2ea", "means": "healthy, posted, received, active, fully received" },
      "warn": { "fg": "#a8762a", "bg": "#f7eeda", "means": "on hold, pending QC, partially received, below reorder" },
      "alert": { "fg": "#a5453d", "bg": "#f7e5e3", "means": "blocked, variance, cancelled, over credit limit" },
      "info": { "fg": "#416180", "bg": "#eef6ff", "means": "approved, sent — in progress, no judgement" },
      "idle": { "fg": "#5d5d60", "bg": "#e7e7ea", "means": "draft, unstarted" }
    }
  },
  "spacing": {
    "$comment": "0.85x density baked in. Exact values.",
    "1": "3.4px",
    "2": "6.8px",
    "3": "10.2px",
    "4": "13.6px",
    "6": "20.4px",
    "8": "27.2px"
  },
  "radius": {
    "$comment": "The system defines these, but this app overrides every component to 0. Chips keep 3px.",
    "sm": "2px",
    "md": "4px",
    "lg": "7px",
    "applied": { "card": "0", "button": "0", "input": "0", "dialog": "0", "chip": "3px" }
  },
  "shadow": {
    "sm": "0 1px 2px color-mix(in srgb, #2b2b2d 14%, transparent)",
    "md": "0 3px 10px color-mix(in srgb, #2b2b2d 16%, transparent)",
    "lg": "0 12px 32px color-mix(in srgb, #2b2b2d 22%, transparent)",
    "$comment": "Only the slide-over drawer, the confirm dialog and the toast carry a shadow. Cards carry none."
  },
  "type": {
    "heading": { "family": "Barlow Condensed, system-ui, sans-serif", "weight": 600, "transform": "uppercase", "tracking": "0.01em" },
    "body": { "family": "Barlow, system-ui, sans-serif", "weight": 400 },
    "scale": {
      "pageTitle": "24px/1",
      "kpiValue": "29px/1",
      "drawerTitle": "26px/1",
      "sectionHeading": "17px, uppercase, 0.04em tracking",
      "navItem": "14px, uppercase, 0.03em tracking",
      "body": "13px",
      "tableCell": "13px (dense) / 14px (comfortable)",
      "tableHeader": "11px, uppercase, 0.08em tracking",
      "meta": "11px",
      "microLabel": "10px, uppercase, 0.14em tracking",
      "navIndex": "9px, 0.08em tracking"
    },
    "numerics": "font-variant-numeric: tabular-nums on every money, quantity, date and count cell"
  },
  "density": {
    "default": "dense",
    "dense": { "baseFontSize": "13px", "tableRowPadding": "4px 8px", "tableFontSize": "13px" },
    "comfortable": { "baseFontSize": "13px", "tableRowPadding": "9px 8px", "tableFontSize": "14px" },
    "materialDensityScale": -2
  },
  "layout": {
    "sidebarWidth": "206px",
    "drawerWidth": "min(580px, 100%)",
    "contentPadding": "20.4px",
    "headerPadding": "10.2px 20.4px",
    "dialogWidth": "min(440px, 100%)"
  },
  "motion": {
    "drawerIn": "slidein 180ms ease-out (translateX 28px -> 0, opacity 0 -> 1)",
    "backdropIn": "fadein 140ms ease-out",
    "dialogIn": "fadein 120ms ease-out",
    "toast": "fadein 140ms ease-out, auto-dismiss at 2400ms"
  },
  "interaction": {
    "focusRing": "2px solid #5980a6, offset 2px",
    "rowHover": "color-mix(in srgb, #1d1f20 4%, transparent)",
    "navHover": "color-mix(in srgb, #ffffff 12%, transparent)",
    "navActive": "#5980a6 fill, white text",
    "buttonPrimaryHover": "#597ea3",
    "buttonPrimaryActive": "#416180",
    "disabledOpacity": 0.45
  }
}
