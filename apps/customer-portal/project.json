{
  "name": "customer-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pos-frontend",
  "sourceRoot": "apps/customer-portal/src",
  "tags": ["scope:pos", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/customer-portal",
          "browser": ""
        },
        "index": "apps/customer-portal/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/customer-portal/tsconfig.app.json",
        "assets": [
          "apps/customer-portal/src/favicon.ico",
          "apps/customer-portal/src/assets"
        ],
        "styles": [
          "node_modules/izitoast/dist/css/iziToast.min.css",
          "node_modules/material-icons/iconfont/material-icons.css",
          "node_modules/@ng-select/ng-select/themes/default.theme.css",
          "apps/customer-portal/src/styles.scss"
        ],
        "scripts": [],
        "browser": "apps/customer-portal/src/main.ts",
        "allowedCommonJsDependencies": ["izitoast"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "customer-portal:build:production"
        },
        "development": {
          "buildTarget": "customer-portal:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "customer-portal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/customer-portal/jest.config.ts",
        "tsConfig": "apps/customer-portal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "customer-portal:build"
      }
    }
  }
}
